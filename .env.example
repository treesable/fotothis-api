# Copy to .env for local runs (`vercel dev`). On Vercel, set these under
# Settings → Environment Variables. Never commit real values.

# Required
PLANTNET_API_KEY=
GROQ_API_KEY=
# Long random string, also in the app. Make one with: openssl rand -hex 32
API_SECRET=

# Optional: the Groq model for species facts (default openai/gpt-oss-120b).
GROQ_MODEL=

# Storage for daily caps, App Attest keys and the fact cache. Added automatically when you
# connect Upstash Redis to the project (Vercel → Storage → Upstash → Redis).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# App Attest: off | log | enforce. Start with "log" (checks and logs, never blocks);
# switch to "enforce" once it works on device.
APP_ATTEST_MODE=log
APPLE_TEAM_ID=J72XXRT45L
APP_BUNDLE_ID=com.treesable.fotothis

# App Store Server API (trial vs paid). Optional until subscriptions exist (week 4):
# without them every device gets the trial cap. App Store Connect → Users and Access →
# Integrations → In-App Purchase → generate a key.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
# The .p8 file's contents on one line, with \n for the line breaks.
APPSTORE_PRIVATE_KEY=

# Species IDs per device per day during the free trial (paid = unlimited).
TRIAL_DAILY_IDS=3
