{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 25,
      "includeFiles": "{db/migrations/**,assets/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "15 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/site?page=aasa"
    },
    {
      "source": "/icon.png",
      "destination": "/api/site?page=icon"
    },
    {
      "source": "/c/:code",
      "destination": "/api/site?page=invite&code=:code"
    },
    {
      "source": "/",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/privacy",
      "destination": "/api/site?page=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/site?page=terms"
    },
    {
      "source": "/api/v1/members/me",
      "destination": "/api/v1/members?route=me"
    },
    {
      "source": "/api/v1/challenges/:path*",
      "destination": "/api/v1/challenges?route=:path*"
    }
  ]
}
